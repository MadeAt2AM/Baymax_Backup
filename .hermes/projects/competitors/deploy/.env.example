# Deployment environment template. Copy to .env and fill in real values
# before running `docker compose up`.

# --- PostgreSQL ---
POSTGRES_DB=competitors
POSTGRES_USER=competitors
POSTGRES_PASSWORD=change-me-strong-32-chars
POSTGRES_PORT=5432

# --- API ---
API_PORT=8000
API_BIND=0.0.0.0:8000
# 32-byte secret used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-this-with-output-of-token-hex-32
# Single-operator credentials. The dashboard has exactly one user.
DASHBOARD_USERNAME=operator
# bcrypt hash of the operator password. Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'changeme', bcrypt.gensalt(10)).decode())"
DASHBOARD_PASSWORD_HASH=replace-this-with-bcrypt-hash
# Allowed origin for CORS (matches the production hostname).
CORS_ORIGIN=https://competitors.terrybot.top

# --- Database connection ---
# The API uses this for SQLAlchemy. The format is libpq URL.
DATABASE_URL=postgresql+psycopg://competitors:change-me-strong-32-chars@postgres:5432/competitors

# --- OpenCLI (dev VPS) ---
# Path to the OpenCLI binary inside the whisper-worker container.
OPENCLI_BIN=/usr/bin/opencli
# Approved Instagram username (the secondary account).
APPROVED_INSTAGRAM_ACCOUNT=mallu.wave
# Site-session directory (mounted from the host).
OPENCLI_PROFILE_DIR=/srv/competitors-private/opencli-profile
# Site-session directory permissions (octal).
OPENCLI_PROFILE_DIR_MODE=0700

# --- Web (Vite static) ---
WEB_PORT=8080
WEB_BIND=0.0.0.0:8080
# API base URL the web bundle talks to. In production this is the same
# hostname via /api, but during dev you'd set it to http://localhost:8000.
VITE_API_BASE_URL=/api

# --- Whisper worker ---
# Model size: tiny | base | small | medium | large-v3
# tiny is the default; ~500 MB of VRAM/disk, 446 ms / 1 s audio on CPU.
WHISPER_MODEL=tiny
# Language code passed to faster-whisper. Empty string = auto-detect.
WHISPER_LANGUAGE=en
# Directory to look for downloaded Instagram reels.
WHISPER_AUDIO_DIR=/srv/competitors-private/audio
# Output JSON directory for publish bundles.
WHISPER_BUNDLE_DIR=/srv/competitors-private/bundles

# --- Caddy (production) ---
# Public hostname for Cloudflare DNS.
COMPETITORS_HOST=competitors.terrybot.top
# Caddy admin port (default 2019).
CADDY_ADMIN_PORT=2019
