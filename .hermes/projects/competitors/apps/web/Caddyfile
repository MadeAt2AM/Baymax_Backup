# Local Caddy config for the web container. The production Caddyfile
# (deploy/Caddyfile) is the one that handles the public hostname.

:8080 {
  root * /srv/web
  encode zstd gzip
  # Single-page application: serve /index.html for any unknown path.
  try_files {path} /index.html
  file_server
  # Cache static assets for 1 hour, HTML for 5 minutes.
  @assets path /assets/*
  header @assets Cache-Control "public, max-age=3600"
  @html path *.html
  header @html Cache-Control "public, max-age=300"
  log
}
