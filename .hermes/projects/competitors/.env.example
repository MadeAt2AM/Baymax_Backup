# Environment template

# Local/Hermes host values
HERMES_PROJECT_ROOT=/root/.hermes/projects/competitors
HERMES_TIMEZONE=Asia/Singapore
DEV_VPS_ALIAS=dev-vps
DEV_VPS_HOST=147.79.18.32

# Dev VPS application values
POSTGRES_DB=competitors
POSTGRES_USER=competitors
POSTGRES_PASSWORD=
DATABASE_URL=
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD_HASH=
SESSION_SECRET=
APP_ORIGIN=https://competitors.terrybot.top
TZ=Asia/Singapore

# Self-hosted Instagram scraper. Values must remain outside git.
OPENCLI_PROFILE_DIR=/srv/competitors-private/opencli-profile
INSTAGRAM_SCRAPER_ACCOUNT=

# Local Faster-Whisper. Model revision is selected after VPS capacity benchmark.
WHISPER_MODEL=
WHISPER_MODEL_REVISION=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=
WHISPER_WORKERS=1
MAX_REELS_PER_ACCOUNT=3
MAX_REELS_PER_RUN=50
MAX_MEDIA_BYTES=104857600
MAX_MEDIA_DURATION_SECONDS=180
