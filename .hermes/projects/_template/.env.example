# Copy this to .env and fill in real values for local dev.
# On the dev VPS, .env lives at /srv/projects/<PROJECT_NAME>/.env (gitignored)
# and is the runtime source of truth.

# ─── app config ────────────────────────────────────────
NODE_ENV=production
PORT=8080

# ─── external services (example) ───────────────────────
DATABASE_URL=
API_KEY_SECRET=
