# Nginx reverse proxy config for Hermes Dashboard
# Location: /etc/nginx/sites-available/<your-domain>
#
# IMPORTANT: Strip the Authorization header after nginx's Basic Auth consumes it.
# DO NOT use: proxy_set_header Authorization $http_authorization;
# USE:        proxy_set_header Authorization "";
# See references/auth-architecture.md for why.

# HTTP -> HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;
    return 301 https://$host$request_uri;
}

# HTTPS reverse proxy with Basic Auth
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name YOUR_DOMAIN;

    ssl_certificate /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # HTTP Basic Auth — browser caches after first successful auth
    auth_basic "Hermes";
    auth_basic_user_file /etc/nginx/.htpasswd;

    location / {
        # Strip Authorization header after Basic Auth is consumed.
        # The SPA sends session token via X-Hermes-Session-Token header.
        # WS endpoints use ?token=<session> query param.
        proxy_set_header Authorization "";

        proxy_pass http://127.0.0.1:9119;
        proxy_http_version 1.1;

        # Single Host header — backend expects 127.0.0.1:9119
        proxy_set_header Host 127.0.0.1:9119;

        # Pass real client IP
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Clear hop-by-hop headers
        proxy_set_header Connection "";
        proxy_set_header Proxy-Connection "";
    }
}