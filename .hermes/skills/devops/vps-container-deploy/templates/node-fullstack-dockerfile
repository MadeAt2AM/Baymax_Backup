# Payntra-class multi-stage Dockerfile for Node 20 + Vite frontend + Fastify/Express backend.
#
# Bakes in the lessons from the vps-container-deploy skill pitfalls:
#   - bcrypt → bcryptjs (no native build)        [pitfall I]
#   - no `apk add` in alpine runtime             [pitfall J]
#   - HEALTHCHECK uses 127.0.0.1 not localhost   [pitfall K]
#   - app must join the `web` external network   [pitfall L]
#
# Pattern: two build stages (client + server) → one runtime image that serves
# the static client from /app/public via the Fastify/Express static plugin.
# Single port. Single container. Caddy proxies subdomain → container:3000.

# ─── Stage 1: client build ────────────────────────────────
FROM node:20-alpine AS client-builder
WORKDIR /client
COPY client/package.json client/package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund
COPY client/ ./
RUN npm run build

# ─── Stage 2: server build ────────────────────────────────
FROM node:20-alpine AS server-builder
WORKDIR /server
COPY server/package.json server/package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund
COPY server/ ./
RUN npm run build

# ─── Stage 3: runtime ─────────────────────────────────────
FROM node:20-alpine
WORKDIR /app

# NO `apk add` here — node:20-alpine already ships wget + ca-certs + curl-busybox.

# Copy built server
COPY --from=server-builder /server/dist ./dist
COPY --from=server-builder /server/node_modules ./node_modules
COPY --from=server-builder /server/package.json ./

# Copy built client into server's public dir
COPY --from=client-builder /client/dist ./public

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

# Healthcheck: 127.0.0.1 (NOT localhost — alpine DNS can fail). See pitfall K.
HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
  CMD wget -q -O - http://127.0.0.1:3000/api/health || exit 1

CMD ["node", "dist/index.js"]