[{
  "id": "github-push",
  "execute-command": "/srv/scripts/project_dev.sh",
  "pass-arguments-to-command": [
    { "source": "string",  "name": "redeploy" },
    { "source": "payload", "name": "repository.name" }
  ],
  "include-command-output-in-response": true,
  "user": "deploy",
  "trigger-rule": {
    "and": [
      { "match": { "type": "payload-hmac-sha256", "secret": "REPLACE_ME_WITH_OPENSSL_RAND_HEX_32", "parameter": { "source": "header", "name": "X-Hub-Signature-256" } } },
      { "match": { "type": "value",               "value": "refs/heads/main",                "parameter": { "source": "payload", "name": "ref" } } }
    ]
  }
}]
