# ============================================================
# Baymax Backup — .gitignore
# Excludes cache-heavy, machine-specific, and regenerable data
# ============================================================

# ── Hermes Caches (HUGE — never commit) ──────────────────────
.hermes/cache/**
.hermes/audio_cache/**
.hermes/image_cache/**
.hermes/images/**
.hermes/sessions/**
.hermes/sandboxes/**
.hermes/state-snapshots/**
.hermes/lsp/**
.hermes/.venv/**
.hermes/node/**
.hermes/pastes/**

# ── Global Node / NPM (regenerate with npm install) ─────────
node_modules/**
.npm/**
!.npm/.npmrc

# ── Python Caches ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyc
.pip-cache/
.pip/
.eggs/
*.egg-info/

# ── Browser Profiles (large + machine-specific) ─────────────
.camofox/**
.camoufox/**
.cloakbrowser/**
.cache/**

# ── HyperFrames Render Cache ────────────────────────────────
.hyperframes/**

# ── Local UV / Pip caches ───────────────────────────────────
.local/share/uv/**
.local/state/**
.pip/

# ── Large binaries (regenerate via: curl -LsSf https://astral.sh/uv/install.sh | sh) ──
.hermes/bin/uv
.hermes/bin/uvx
.local/bin/uv
.local/bin/uvx
uv
uvx
uvx*

# ── Backup data copies of large binaries ───────────────────
baymax_backup/backup_data/hermes_bin/uv
baymax_backup/backup_data/hermes_bin/uvx
baymax_backup/backup_data/hidden_configs/.local_bin/uv
baymax_backup/backup_data/hidden_configs/.local_bin/uvx

# ── Docker (images are massive — rebuild on restore) ─────────
.docker/buildx/**
.docker/buildkit/**

# ── Python venvs for tool-specific packages (regenerate on restore) ──
.agent-reach-venv/**
.agent-reach-venv/

# ── Local ML model weights (download on demand) ─────────────
.kokoro/models/**
.kokoro/models/

# ── Headless browser bundles (reinstalled by playwright/patchright) ──
.linkedin-mcp/patchright-browsers/**
.linkedin-mcp/patchright-browsers/

# ── System temp files ────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.fuse_hidden*
.Trash-*

# ── Hermes lock/state files (regenerated on startup) ─────────
.hermes/gateway.lock
.hermes/gateway.pid
.hermes/interrupt_debug.log
.hermes/verification_evidence.db
.hermes/kanban.db.dispatch.lock
.hermes/kanban.db.init.lock
.hermes/processes.json
.hermes/gateway_state.json
.hermes/models_dev_cache.json
.hermes/ollama_cloud_models_cache.json
.hermes/provider_models_cache.json
.hermes/state.db
.hermes/state.db-shm
.hermes/state.db-wal
.hermes/tmp-nginx-dashboard/**

# ── Logs (keep dir structure, not content) ───────────────────
*.log
logs/

# ── Secret / private key files (keep redacted copies) ────────
# .env and auth.json are INCLUDED (backed up with real tokens)
# but never push .ssh/ private keys
.ssh/*.pem
.ssh/id_rsa
.ssh/id_ed25519
.ssh/id_dsa
.ssh/*.key
_ssh_key*_redacted*

# ── Downloaded debs (package manager artifacts) ──────────────
Downloads/*.deb
Downloads/*.rpm
Downloads/*.zip
Downloads/*.tar.gz

# ── Git metadata for sub-repos ───────────────────────────────
# (Obsidian Vault has its own .git — exclude it from outer repo)
Obsidian-Vaults/.git/
browser-search/.git/

# ── Large media files ────────────────────────────────────────
*.mp4
*.mov
*.avi
*.mkv
*.zip > 10MB
*.tar.gz > 10MB
*.img > 10MB

# ── IDE / Editor files ───────────────────────────────────────
.vscode/settings.json
.idea/
*.sublime-*

# ── Honcho memory DB (runtime state — exclude) ──────────────
.honcho/*.db
.honcho/*.db-*

# ── Restore note ─────────────────────────────────────────────
# Everything excluded here is either:
#   A) Regenerated automatically by Hermes on startup
#   B) Too large/machine-specific to back up
#   C) Machine-specific runtime state
#
# What IS included:
#   ✅ /root/.hermes/.env           (secrets — RESTORE FIRST)
#   ✅ /root/.hermes/config.yaml    (full configuration)
#   ✅ /root/.hermes/auth.json      (credentials pool)
#   ✅ /root/.hermes/kanban.db      (task state)
#   ✅ /root/.hermes/skills/        (all skill definitions)
#   ✅ /root/.hermes/memories/      (persistent memory)
#   ✅ /root/.hermes/projects/      (all projects)
#   ✅ /root/.hermes/plugins/       (plugin configs)
#   ✅ /root/.hermes/scripts/       (custom scripts)
#   ✅ /root/.hermes/cron/          (scheduled jobs state)
#   ✅ /root/.hermes/honcho.json    (Honcho memory config)
#   ✅ /root/.local/bin/            (hermes CLI, uv, npm symlinks)
#   ✅ /root/.config/fish/         (fish shell config)
#   ✅ /root/.config/gh/           (GitHub CLI config)
#   ✅ /root/.config/uv/           (uv config)
#   ✅ /root/.bashrc, .profile, .zshrc  (shell configs)
#   ✅ /root/.viminfo               (vim editor state)
#   ✅ /root/.honcho/config.json    (Honcho app config)
#   ✅ /root/.ssh/authorized_keys   (empty on this VPS — add yours)
#   ✅ /root/browser-search/        (SearXNG config)
#   ✅ /root/Obsidian-Vaults/       (LLM Wiki)
#   ✅ Root-level project folders
#   ✅ Systemd service files
#   ✅ Nginx + Docker compose configs
#
# Browser profiles excluded (too large, machine-specific):
#   🚫 /root/.camofox/  (browser fingerprint data — regenerate per install)
#   🚫 /root/.camoufox/ (same)
#   🚫 /root/.cloakbrowser/
