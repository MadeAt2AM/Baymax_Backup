# HTTP -> HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name dashboard.terrybot.top;
    return 301 https://$host$request_uri;
}

# HTTPS reverse proxy with Basic Auth
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name dashboard.terrybot.top;

    ssl_certificate /etc/letsencrypt/live/dashboard.terrybot.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dashboard.terrybot.top/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # HTTP Basic Auth
    auth_basic "Restricted Access";
    auth_basic_user_file /etc/nginx/.htpasswd;

    # Root: reverse proxy to Hermes dashboard
    location / {
        proxy_pass http://127.0.0.1:9119;
        proxy_http_version 1.1;

        # Single Host header — backend expects 127.0.0.1:9119 to validate
        proxy_set_header Host 127.0.0.1:9119;

        # Pass real client IP
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Forward Authorization header so backend XHR calls don't re-prompt
        proxy_set_header Authorization $http_authorization;

        # Clear hop-by-hop headers
        proxy_set_header Connection "";
        proxy_set_header Proxy-Connection "";
    }
}